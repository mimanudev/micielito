---
// Sección 1: Dos Oruguitas evolucionando en Mariposas
---

<section
  id="oruguitasSection"
  class="w-full max-w-5xl mx-auto my-20 px-4 scroll-mt-24"
  style="content-visibility: auto; contain-intrinsic-size: 650px;"
>
  <div class="relative rounded-[2.5rem] p-6 sm:p-10 md:p-12 bg-gradient-to-b from-[#0f1712]/90 via-[#131f18]/90 to-[#0c140f]/90 border border-emerald-500/30 shadow-[0_0_50px_rgba(16,185,129,0.15)] backdrop-blur-xl overflow-hidden text-center">
    
    <!-- Background Ambient Glow -->
    <div class="absolute -top-20 -left-20 w-72 h-72 bg-emerald-500/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-20 -right-20 w-72 h-72 bg-amber-500/15 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Chapter Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-emerald-500/15 border border-emerald-400/30 text-emerald-300 text-xs uppercase tracking-widest font-semibold mb-4">
      <span>🌿</span>
      <span>Capítulo I — El Viaje Juntos</span>
      <span>🦋</span>
    </div>

    <!-- Title -->
    <h2 class="font-serif text-3xl sm:text-4xl md:text-5xl text-amber-100 font-medium tracking-wide drop-shadow-sm mb-4">
      Dos Oruguitas
    </h2>

    <!-- Poetic Narrative -->
    <p class="font-romantic text-lg sm:text-xl md:text-2xl text-emerald-100/90 max-w-2xl mx-auto italic leading-relaxed mb-8">
      "Dos oruguitas enamoradas pasan sus días y noches enteras...<br class="hidden sm:inline" />
      Creciendo juntas, abrazando cada cambio con paciencia, hasta que un día abren sus alas para volar libres en el mismo cielo."
    </p>

    <!-- ANIMATION STAGE CONTAINER -->
    <div class="relative w-full max-w-lg mx-auto h-64 sm:h-72 my-4 rounded-3xl bg-black/40 border border-emerald-500/20 flex items-center justify-center overflow-hidden p-4 shadow-inner">
      
      <!-- Stage 1: The Two Caterpillars (Oruguitas) -->
      <div id="caterpillarsStage" class="flex items-center justify-center gap-6 sm:gap-10 transition-all duration-700">
        <!-- Caterpillar 1 -->
        <div id="oruguita1" class="flex flex-col items-center cursor-pointer group">
          <svg viewBox="0 0 120 70" class="w-24 sm:w-28 h-auto drop-shadow-[0_0_10px_rgba(52,211,153,0.5)]">
            <!-- Caterpillar segments -->
            <ellipse cx="25" cy="45" rx="14" ry="12" fill="#34d399" />
            <ellipse cx="45" cy="40" rx="13" ry="11" fill="#10b981" />
            <ellipse cx="65" cy="42" rx="13" ry="11" fill="#34d399" />
            <ellipse cx="85" cy="38" rx="14" ry="12" fill="#10b981" />
            <!-- Head -->
            <circle cx="102" cy="32" r="14" fill="#059669" />
            <circle cx="107" cy="28" r="3.5" fill="#ffffff" />
            <circle cx="108" cy="28" r="2" fill="#064e3b" />
            <!-- Blush -->
            <circle cx="105" cy="37" r="3.5" fill="#f472b6" opacity="0.8" />
            <!-- Antennae -->
            <path d="M 104 20 Q 106 10 114 12" stroke="#064e3b" stroke-width="2.5" fill="none" stroke-linecap="round" />
            <path d="M 98 20 Q 96 10 90 14" stroke="#064e3b" stroke-width="2.5" fill="none" stroke-linecap="round" />
            <!-- Little smile -->
            <path d="M 108 34 Q 105 38 102 35" stroke="#064e3b" stroke-width="1.8" fill="none" />
          </svg>
          <span class="text-[11px] font-mono text-emerald-300/80 mt-1">Tú &amp; Yo</span>
        </div>

        <!-- Floating heart in between -->
        <div id="caterpillarHeart" class="text-2xl animate-pulse text-pink-400 select-none">
          💚
        </div>

        <!-- Caterpillar 2 -->
        <div id="oruguita2" class="flex flex-col items-center cursor-pointer group transform scale-x-[-1]">
          <svg viewBox="0 0 120 70" class="w-24 sm:w-28 h-auto drop-shadow-[0_0_10px_rgba(251,191,36,0.5)]">
            <!-- Caterpillar segments in gold/amber -->
            <ellipse cx="25" cy="45" rx="14" ry="12" fill="#fde047" />
            <ellipse cx="45" cy="40" rx="13" ry="11" fill="#f59e0b" />
            <ellipse cx="65" cy="42" rx="13" ry="11" fill="#fde047" />
            <ellipse cx="85" cy="38" rx="14" ry="12" fill="#f59e0b" />
            <!-- Head -->
            <circle cx="102" cy="32" r="14" fill="#d97706" />
            <circle cx="107" cy="28" r="3.5" fill="#ffffff" />
            <circle cx="108" cy="28" r="2" fill="#78350f" />
            <!-- Blush -->
            <circle cx="105" cy="37" r="3.5" fill="#f472b6" opacity="0.8" />
            <!-- Antennae -->
            <path d="M 104 20 Q 106 10 114 12" stroke="#78350f" stroke-width="2.5" fill="none" stroke-linecap="round" />
            <path d="M 98 20 Q 96 10 90 14" stroke="#78350f" stroke-width="2.5" fill="none" stroke-linecap="round" />
            <!-- Smile -->
            <path d="M 108 34 Q 105 38 102 35" stroke="#78350f" stroke-width="1.8" fill="none" />
          </svg>
          <span class="text-[11px] font-mono text-amber-300/80 mt-1 transform scale-x-[-1]">Mi Cielito</span>
        </div>
      </div>

      <!-- Stage 2: Chrysalis / Cocoon (Crisálida Dorada) -->
      <div id="cocoonStage" class="absolute inset-0 flex flex-col items-center justify-center opacity-0 pointer-events-none">
        <div class="relative w-20 h-28 rounded-full bg-gradient-to-b from-amber-300 via-amber-500 to-emerald-700 shadow-[0_0_40px_rgba(251,191,36,0.8)] border border-amber-200/50 animate-pulse flex items-center justify-center">
          <span class="text-2xl animate-spin-slow">✨</span>
        </div>
        <p class="text-xs font-serif text-amber-200 mt-3 italic tracking-wider">
          El amor transformándose...
        </p>
      </div>

      <!-- Stage 3: The Two Evolved Butterflies (Mariposas) -->
      <div id="butterfliesStage" class="absolute inset-0 flex items-center justify-around px-8 opacity-0 pointer-events-none">
        <!-- Butterfly 1 (Emerald/Cyan) -->
        <div id="butterfly1" class="flex flex-col items-center">
          <svg viewBox="0 0 100 100" class="w-24 sm:w-32 h-24 sm:h-32 drop-shadow-[0_0_20px_rgba(52,211,153,0.9)]">
            <defs>
              <linearGradient id="bfGrad1" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#a7f3d0" />
                <stop offset="50%" stop-color="#10b981" />
                <stop offset="100%" stop-color="#047857" />
              </linearGradient>
            </defs>
            <!-- Left Wing -->
            <path class="wing-left origin-right" d="M 50 50 C 20 10 5 35 15 55 C 20 65 35 70 50 50 Z" fill="url(#bfGrad1)" opacity="0.95" />
            <path class="wing-left origin-right" d="M 50 52 C 25 60 18 80 32 85 C 42 88 48 70 50 52 Z" fill="#34d399" opacity="0.8" />
            <!-- Right Wing -->
            <path class="wing-right origin-left" d="M 50 50 C 80 10 95 35 85 55 C 80 65 65 70 50 50 Z" fill="url(#bfGrad1)" opacity="0.95" />
            <path class="wing-right origin-left" d="M 50 52 C 75 60 82 80 68 85 C 58 88 52 70 50 52 Z" fill="#34d399" opacity="0.8" />
            <!-- Body -->
            <ellipse cx="50" cy="52" rx="3.5" ry="20" fill="#064e3b" />
            <!-- Antennae -->
            <path d="M 50 32 Q 42 18 36 20" stroke="#a7f3d0" stroke-width="2" fill="none" stroke-linecap="round" />
            <path d="M 50 32 Q 58 18 64 20" stroke="#a7f3d0" stroke-width="2" fill="none" stroke-linecap="round" />
          </svg>
          <span class="text-xs font-serif text-emerald-300">Siempre libres</span>
        </div>

        <!-- Center Sparkles -->
        <div class="text-2xl text-amber-300 animate-bounce">
          ✨🦋✨
        </div>

        <!-- Butterfly 2 (Golden/Amber) -->
        <div id="butterfly2" class="flex flex-col items-center">
          <svg viewBox="0 0 100 100" class="w-24 sm:w-32 h-24 sm:h-32 drop-shadow-[0_0_20px_rgba(251,191,36,0.9)]">
            <defs>
              <linearGradient id="bfGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#fef08a" />
                <stop offset="50%" stop-color="#f59e0b" />
                <stop offset="100%" stop-color="#b45309" />
              </linearGradient>
            </defs>
            <!-- Left Wing -->
            <path class="wing-left origin-right" d="M 50 50 C 20 10 5 35 15 55 C 20 65 35 70 50 50 Z" fill="url(#bfGrad2)" opacity="0.95" />
            <path class="wing-left origin-right" d="M 50 52 C 25 60 18 80 32 85 C 42 88 48 70 50 52 Z" fill="#fde047" opacity="0.8" />
            <!-- Right Wing -->
            <path class="wing-right origin-left" d="M 50 50 C 80 10 95 35 85 55 C 80 65 65 70 50 50 Z" fill="url(#bfGrad2)" opacity="0.95" />
            <path class="wing-right origin-left" d="M 50 52 C 75 60 82 80 68 85 C 58 88 52 70 50 52 Z" fill="#fde047" opacity="0.8" />
            <!-- Body -->
            <ellipse cx="50" cy="52" rx="3.5" ry="20" fill="#78350f" />
            <!-- Antennae -->
            <path d="M 50 32 Q 42 18 36 20" stroke="#fde047" stroke-width="2" fill="none" stroke-linecap="round" />
            <path d="M 50 32 Q 58 18 64 20" stroke="#fde047" stroke-width="2" fill="none" stroke-linecap="round" />
          </svg>
          <span class="text-xs font-serif text-amber-300">Siempre juntos</span>
        </div>
      </div>
    </div>

    <!-- Interactive Button to trigger or replay Evolution -->
    <div class="mt-6 flex items-center justify-center gap-3">
      <button
        id="evolveBtn"
        type="button"
        class="px-6 py-2.5 rounded-full bg-gradient-to-r from-emerald-400 to-teal-500 hover:from-emerald-300 hover:to-teal-400 text-emerald-950 font-semibold text-xs sm:text-sm tracking-wider uppercase shadow-[0_0_20px_rgba(52,211,153,0.4)] hover:shadow-[0_0_35px_rgba(52,211,153,0.7)] transition-all duration-300 hover:scale-105 active:scale-95 cursor-pointer flex items-center gap-2"
      >
        <span id="evolveBtnIcon">✨</span>
        <span id="evolveBtnText">Evolucionar Juntas</span>
      </button>

      <span class="text-[11px] text-emerald-300/60 hidden sm:inline">
        (O se activa automáticamente al hacer scroll)
      </span>
    </div>
  </div>
</section>
