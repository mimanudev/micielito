---
interface Props {
  imageUrl: string;
  altText?: string;
  tagline?: string;
}

const { 
  imageUrl, 
  altText = "Recuerdo Especial", 
  tagline = "• ERES MI CIELITO • ERES MI COSTILLITA • NO OLVIDES NUESTRO AMOR • "
} = Astro.props;
---

<div class="relative flex items-center justify-center p-8 my-8 select-none">
  <!-- Glowing background rings -->
  <div class="absolute w-72 h-72 md:w-84 md:h-84 rounded-full bg-gradient-to-tr from-amber-500/20 via-yellow-400/30 to-purple-600/20 blur-2xl animate-pulse"></div>
  <div class="absolute w-64 h-64 md:w-76 md:h-76 rounded-full border border-amber-400/30 shadow-[0_0_35px_rgba(251,191,36,0.3)]"></div>

  <!-- Rotating SVG Curved Text -->
  <div class="absolute w-72 h-72 md:w-84 md:h-84 animate-spin-slow pointer-events-none z-20">
    <svg viewBox="0 0 300 300" class="w-full h-full">
      <defs>
        <!-- Circle path for the text to follow -->
        <path
          id="textCirclePath"
          d="M 150, 150 m -120, 0 a 120,120 0 1,1 240,0 a 120,120 0 1,1 -240,0"
          fill="none"
        />
      </defs>
      <text fill="#fde68a" font-size="10.5" font-family="'Cinzel', serif" font-weight="700" letter-spacing="3.5" class="drop-shadow-[0_0_6px_rgba(251,191,36,0.9)]">
        <textPath href="#textCirclePath" startOffset="0%">
          {tagline}
        </textPath>
      </text>
    </svg>
  </div>

  <!-- Circular Photo Container -->
  <div class="relative z-10 w-44 h-44 md:w-52 md:h-52 rounded-full overflow-hidden p-1.5 bg-gradient-to-tr from-amber-400 via-yellow-200 to-amber-600 shadow-[0_0_30px_rgba(245,158,11,0.5)] group cursor-pointer transition-transform duration-500 hover:scale-105">
    <div class="w-full h-full rounded-full overflow-hidden bg-black/40 relative">
      <img
        src={imageUrl}
        alt={altText}
        class="w-full h-full object-cover transition-transform duration-750 group-hover:scale-115"
        loading="lazy"
      />
      <!-- Hover Overlay -->
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
        <span class="text-xs font-serif text-amber-200 uppercase tracking-widest font-semibold px-3 py-1 rounded-full bg-black/50 backdrop-blur-sm border border-amber-300/40">
          Ver ✨
        </span>
      </div>
    </div>
  </div>

  <!-- Decorative small golden stars / sparkles -->
  <div class="absolute -top-1 -right-1 text-amber-300 text-lg animate-bounce" style="animation-delay: 0.2s;">✦</div>
  <div class="absolute -bottom-2 -left-2 text-yellow-200 text-base animate-bounce" style="animation-delay: 0.7s;">★</div>
</div>
