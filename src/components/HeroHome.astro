---
const rawBase = import.meta.env.BASE_URL || "/";
const baseUrl = rawBase.endsWith("/") ? rawBase.slice(0, -1) : rawBase;
import SunflowerSvg from "./SunflowerSvg.astro";
---

<section id="heroCardSection" class="invite" data-state="idle">
    <div class="invite-tilt" data-tilt>
        <div class="env" data-env>
            <div class="env-back" data-back></div>

            <!-- La carta vive dentro de un recorte que solo corta por abajo:
                 puede salir hacia arriba, pero nunca asoma bajo el sobre -->
            <div class="letter-slot" data-slot>
                <article
                    id="heroCard"
                    class="letter"
                    data-letter
                    inert
                    aria-hidden="true"
                    aria-label="Invitación"
                >
                    <p class="eyebrow">Una invitación para ti</p>
                    <h1>Flores amarillas<br /><em>para ti</em></h1>

                    <div class="illustration">
                        <SunflowerSvg className="w-10 h-10 sm:w-12 sm:h-12" />
                        <img
                            src={`${baseUrl}/images/compressed/inicio.webp`}
                            alt="Ositos abrazándose con cariño"
                            width="480"
                            height="441"
                            loading="eager"
                            fetchpriority="high"
                            decoding="async"
                        />
                        <SunflowerSvg className="w-10 h-10 sm:w-12 sm:h-12" />
                    </div>

                    <p class="message">
                        Nuestra historia de amor,<br /><em>gracias por existir.</em>
                    </p>

                    <div class="actions">
                        <a class="cta" href={`${baseUrl}/historia/`}
                            >Ver nuestra historia <span aria-hidden="true">→</span></a
                        >
                        <a class="cta-alt" href={`${baseUrl}/recuerdos/`}
                            >Abrir recuerdos</a
                        >
                    </div>

                    <p class="signature">De Manuel · Para Moni</p>
                </article>
            </div>

            <div class="env-front" data-front>
                <div class="address" data-address>
                    <span class="mono">Para</span>
                    <strong>Moni</strong>
                    <span class="mono">De Manuel · con todo el corazón</span>
                </div>
            </div>
            <div class="env-flap" data-flap aria-hidden="true"></div>

            <button
                id="envelopeSeal"
                class="seal"
                data-seal
                type="button"
                aria-label="Abrir el sobre"
                ><span>M<i>♥</i>M</span></button
            >
        </div>
    </div>

    <p class="hint" data-hint>Toca el sello para abrir</p>
    <p class="sr-only" data-status role="status" aria-live="polite"></p>
</section>

<script>
    import gsap from "gsap";

    const $ = <T extends HTMLElement = HTMLElement>(sel: string) =>
        document.querySelector<T>(sel)!;

    const root = $("#heroCardSection");
    const tilt = $("[data-tilt]");
    const env = $("[data-env]");
    const back = $("[data-back]");
    const slot = $("[data-slot]");
    const letter = $("[data-letter]");
    const front = $("[data-front]");
    const flap = $("[data-flap]");
    const seal = $("[data-seal]");
    const address = $("[data-address]");
    const hint = $("[data-hint]");
    const status = $("[data-status]");
    const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
    ).matches;

    // Altura (en fracción del sobre) del borde del bolsillo donde la carta está más arriba
    const POCKET_EDGE = 0.06;
    let state: "idle" | "opening" | "opened" = "idle";

    // Mide el sobre, la carta y la escena para calcular cada posición del recorrido
    function measure() {
        const H = env.offsetHeight;
        const L = letter.offsetHeight;
        const top0 = letter.offsetTop;
        const sceneH = root.clientHeight;
        const pad = 16;
        // La carta sale hasta que su borde inferior queda por encima del bolsillo
        const out = -(top0 + L - POCKET_EDGE * H) - 8;
        // Mientras sale, el sobre baja para que la carta no se salga de la pantalla
        // (puede hundirse en parte bajo el borde de la pantalla, como si saliera de cuadro)
        const drop = gsap.utils.clamp(
            0,
            Math.max(0, sceneH / 2 - 0.3 * H),
            L + (1 - POCKET_EDGE) * H - H / 2 + pad - sceneH / 2 + 8,
        );
        // Al final, la carta queda centrada y, si no cabe, un poco más pequeña
        const scale = Math.min(1, (sceneH - pad * 2) / L);
        const final = H / 2 - L / 2 - top0 - drop;
        return { out, drop, final, scale };
    }

    function finish() {
        state = "opened";
        root.dataset.state = state;
        slot.style.clipPath = "none";
        slot.style.zIndex = "8";
        letter.removeAttribute("inert");
        letter.removeAttribute("aria-hidden");
        status.textContent = "Carta lista";
    }

    function open() {
        if (state !== "idle") return;
        state = "opening";
        root.dataset.state = state;
        status.textContent = "Abriendo el sobre";
        tilt.style.transform = "";

        const { out, drop, final, scale } = measure();

        if (reduceMotion) {
            slot.classList.add("is-visible");
            gsap.set([back, front, flap, seal], { autoAlpha: 0 });
            gsap.set(env, { y: drop });
            gsap.set(letter, { y: final, scale });
            finish();
            return;
        }

        gsap.timeline({ defaults: { ease: "power2.inOut" }, onComplete: finish })
            .to(hint, { autoAlpha: 0, duration: 0.4 }, 0)
            // 1. El sello se rompe
            .to(seal, { scale: 1.12, duration: 0.18, ease: "power1.out" }, 0)
            .to(seal, { scale: 0.4, rotate: -25, autoAlpha: 0, duration: 0.45, ease: "back.in(1.6)" }, 0.18)
            // 2. La solapa se abre; a mitad de giro (de canto, invisible) pasa detrás de la carta y muestra su cara interior
            .to(flap, { rotateX: 90, duration: 0.75, ease: "power2.in" }, 0.35)
            .add(() => slot.classList.add("is-visible"), 0.95)
            .add(() => flap.classList.add("is-open"), 1.1)
            .set(flap, { zIndex: 1 }, 1.1)
            .to(flap, { rotateX: 180, duration: 0.85, ease: "power2.out" }, 1.1)
            .to(address, { autoAlpha: 0, y: 10, duration: 0.6 }, 0.5)
            // 3. La carta sale despacio del bolsillo mientras el sobre baja
            .to(letter, { y: out, duration: 3.4, ease: "sine.inOut" }, 1.6)
            .to(env, { y: drop, duration: 3.4, ease: "sine.inOut" }, 1.6)
            // 4. Ya fuera, pasa por delante (sin solaparse: no hay salto) y se coloca en el centro
            .add(() => {
                slot.style.clipPath = "none";
                slot.style.zIndex = "8";
            }, 5.0)
            .to(letter, { y: final, scale, duration: 1.6, ease: "power3.inOut" }, 5.05)
            .to([back, front, flap], { y: 60, autoAlpha: 0, duration: 1.2, ease: "power2.in" }, 5.1);
    }

    gsap.set(flap, { transformPerspective: 900 });
    seal.addEventListener("click", open);

    // Si cambia el tamaño de la ventana con la carta abierta, se vuelve a centrar
    window.addEventListener("resize", () => {
        if (state !== "opened") return;
        const { drop, final, scale } = measure();
        gsap.set(env, { y: drop });
        gsap.set(letter, { y: final, scale });
    });

    // Inclinación suave del sobre siguiendo el ratón (solo antes de abrirlo)
    if (
        !reduceMotion &&
        window.matchMedia("(hover: hover) and (pointer: fine)").matches
    ) {
        let frame = 0;
        let tx = 0;
        let ty = 0;
        let cx = 0;
        let cy = 0;
        const animate = () => {
            cx += (tx - cx) * 0.08;
            cy += (ty - cy) * 0.08;
            tilt.style.transform =
                state === "idle"
                    ? `rotateX(${(-cy * 5).toFixed(2)}deg) rotateY(${(cx * 7).toFixed(2)}deg)`
                    : "";
            frame =
                state === "idle" &&
                (Math.abs(tx - cx) > 0.001 || Math.abs(ty - cy) > 0.001)
                    ? requestAnimationFrame(animate)
                    : 0;
        };
        root.addEventListener(
            "pointermove",
            (e) => {
                const b = root.getBoundingClientRect();
                tx = gsap.utils.clamp(-1, 1, ((e.clientX - b.left) / b.width) * 2 - 1);
                ty = gsap.utils.clamp(-1, 1, ((e.clientY - b.top) / b.height) * 2 - 1);
                if (!frame) frame = requestAnimationFrame(animate);
            },
            { passive: true },
        );
        root.addEventListener("pointerleave", () => {
            tx = 0;
            ty = 0;
            if (!frame) frame = requestAnimationFrame(animate);
        });
    }
</script>

<style>
    .invite {
        --wine: #6e1d3f;
        --wine-dark: #4a1129;
        --wine-inner: #2d0a1a;
        --paper: #f8f1e4;
        --ink: #2a1e14;
        --ink-dim: #7a6a58;
        --gold: #e9c46a;

        position: relative;
        display: grid;
        place-items: center;
        width: 100%;
        height: calc(100svh - 4rem);
        min-height: 620px;
        overflow: clip;
        perspective: 1400px;
    }

    .invite-tilt {
        width: min(92vw, 540px);
        transition: transform 0.6s ease;
    }

    /* Al abrir, la flotación se pausa donde esté en lugar de saltar a su posición inicial */
    .invite-tilt {
        animation: float 6s ease-in-out 1s infinite;
    }

    .invite:not([data-state="idle"]) .invite-tilt {
        animation-play-state: paused;
    }

    /* Sobre apaisado, como uno de verdad */
    .env {
        position: relative;
        aspect-ratio: 3 / 2;
        isolation: isolate;
    }

    .env-back,
    .env-front,
    .env-flap {
        position: absolute;
        left: 0;
        right: 0;
    }

    /* Interior del sobre: lo que se ve por la abertura */
    .env-back {
        z-index: 1;
        inset: 0;
        border-radius: 6px;
        background:
            linear-gradient(180deg, rgb(0 0 0 / 0.35), transparent 40%),
            var(--wine-inner);
        box-shadow: 0 2.5rem 5rem rgb(0 0 0 / 0.55);
    }

    .letter-slot {
        position: absolute;
        z-index: 2;
        inset: 0;
        /* Corta solo lo que quede por debajo del sobre */
        clip-path: inset(-300% -20% 0 -20%);
    }

    /* La carta no se pinta hasta que la solapa está medio abierta:
       así no asoma por las juntas entre la solapa y el bolsillo */
    .letter-slot:not(.is-visible) {
        visibility: hidden;
    }

    /* Bolsillo delantero: laterales y triángulo inferior. Llega hasta las esquinas de arriba
       para que, con el sobre cerrado, la carta no asome entre la solapa y el bolsillo */
    .env-front {
        z-index: 4;
        inset: 0;
        border-radius: 6px;
        clip-path: polygon(0 0, 50% 62%, 100% 0, 100% 100%, 0 100%);
        background:
            linear-gradient(160deg, rgb(255 255 255 / 0.08), transparent 45%),
            linear-gradient(200deg, var(--wine) 0%, var(--wine-dark) 100%);
    }

    /* Pliegues: dos sombras diagonales hacia el centro */
    .env-front::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            linear-gradient(to top right, transparent 49.6%, rgb(0 0 0 / 0.18) 50%, transparent 50.6%),
            linear-gradient(to top left, transparent 49.6%, rgb(0 0 0 / 0.18) 50%, transparent 50.6%);
        opacity: 0.6;
    }

    .env-flap {
        z-index: 6;
        top: 0;
        height: 60%;
        transform-origin: 50% 0;
        clip-path: polygon(0 0, 100% 0, 50% 100%);
        background:
            linear-gradient(180deg, rgb(255 255 255 / 0.1), transparent 60%),
            linear-gradient(180deg, #84254d, var(--wine) 80%);
        filter: drop-shadow(0 6px 10px rgb(0 0 0 / 0.35));
    }

    /* Cara interior de la solapa, visible cuando está abierta */
    .env-flap.is-open {
        background: linear-gradient(0deg, #3b0e22, var(--wine-inner));
    }

    .address {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 7%;
        display: grid;
        justify-items: center;
        gap: 0.15rem;
        color: #f6dcc8;
        text-align: center;
    }

    .address strong {
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: clamp(1.9rem, 6vw, 2.6rem);
        font-style: italic;
        font-weight: 400;
        line-height: 1;
    }

    /* En pantallas estrechas el sello ocuparía el sitio de «Para» */
    @media (max-width: 480px) {
        .address > .mono:first-child {
            display: none;
        }
    }

    .mono {
        font-family: "DM Mono", ui-monospace, monospace;
        font-size: 0.68rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        opacity: 0.75;
    }

    /* Sello de lacre en la punta de la solapa */
    .seal {
        position: absolute;
        z-index: 7;
        top: 60%;
        left: 50%;
        display: grid;
        place-items: center;
        width: 3.6rem;
        height: 3.6rem;
        margin: -1.8rem 0 0 -1.8rem;
        padding: 0;
        border: 0;
        border-radius: 46% 54% 50% 50% / 52% 48% 52% 48%;
        background: radial-gradient(circle at 35% 30%, #d4384f, #9d1b31 60%, #6f0f22);
        box-shadow:
            0 0.35rem 0.8rem rgb(0 0 0 / 0.45),
            inset 0 0 0 0.35rem rgb(0 0 0 / 0.12),
            inset 0 2px 2px rgb(255 255 255 / 0.25);
        color: #ffe3c4;
        cursor: pointer;
        transition: transform 0.25s ease;
    }

    .seal:hover {
        transform: scale(1.06);
    }

    .seal:focus-visible {
        outline: 2px solid var(--gold);
        outline-offset: 4px;
    }

    .seal span {
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: 1.15rem;
        font-weight: 600;
    }

    .seal i {
        font-size: 0.7em;
        font-style: normal;
    }

    /* La carta: papel crema con tinta oscura */
    .letter {
        position: absolute;
        top: 7%;
        left: 5%;
        width: 90%;
        padding: clamp(1.5rem, 5vw, 2.5rem) clamp(1.25rem, 5vw, 2.5rem) clamp(1.25rem, 4vw, 2rem);
        border-radius: 3px;
        background:
            radial-gradient(120% 80% at 50% 0%, #fffaf0, transparent 70%),
            var(--paper);
        box-shadow:
            0 1.5rem 3.5rem rgb(0 0 0 / 0.35),
            0 0.15rem 0.4rem rgb(0 0 0 / 0.15);
        color: var(--ink);
        text-align: center;
        transform-origin: 50% 50%;
    }

    .eyebrow {
        margin: 0 0 1rem;
        font-family: "DM Mono", ui-monospace, monospace;
        font-size: 0.68rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--ink-dim);
    }

    .letter h1 {
        margin: 0;
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: clamp(2.4rem, 9vw, 3.6rem);
        font-weight: 300;
        line-height: 0.92;
        letter-spacing: -0.02em;
    }

    .letter h1 em {
        font-style: italic;
        color: #9d1b31;
    }

    .illustration {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        margin: 1.25rem 0 0.75rem;
    }

    .illustration img {
        width: clamp(6.5rem, 26vw, 8.5rem);
        height: auto;
    }

    .message {
        margin: 0;
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: clamp(1.2rem, 4vw, 1.45rem);
        line-height: 1.2;
    }

    .message em {
        font-style: italic;
        color: #9d1b31;
    }

    .actions {
        display: grid;
        justify-items: center;
        gap: 0.85rem;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgb(42 30 20 / 0.15);
    }

    .cta {
        display: inline-flex;
        gap: 0.6rem;
        padding: 0.9rem 1.6rem;
        border-radius: 999px;
        background: var(--ink);
        color: var(--paper);
        font-family: "DM Mono", ui-monospace, monospace;
        font-size: 0.75rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        text-decoration: none;
        transition:
            transform 0.25s ease,
            background 0.25s ease;
    }

    .cta:hover {
        transform: translateY(-2px);
        background: #9d1b31;
    }

    .cta-alt {
        color: var(--ink-dim);
        font-family: "DM Mono", ui-monospace, monospace;
        font-size: 0.72rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        text-underline-offset: 0.3em;
    }

    .cta-alt:hover {
        color: var(--ink);
    }

    .signature {
        margin: 1.25rem 0 0;
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: 1.05rem;
        font-style: italic;
        color: var(--ink-dim);
    }

    .hint {
        position: absolute;
        top: calc(50% + min(92vw, 540px) / 3 + 2.5rem);
        left: 0;
        right: 0;
        margin: 0;
        color: rgb(246 220 200 / 0.7);
        font-family: "DM Mono", ui-monospace, monospace;
        font-size: 0.72rem;
        letter-spacing: 0.16em;
        text-align: center;
        text-transform: uppercase;
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    @keyframes float {
        0%,
        100% {
            translate: 0 0;
        }
        50% {
            translate: 0 -0.45rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .invite-tilt {
            animation: none;
        }
    }
</style>
