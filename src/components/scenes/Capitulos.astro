---
const rawBase = import.meta.env.BASE_URL || '/';
const baseUrl = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;

// Cada capítulo: una foto, su fecha y el color con el que se tiñe la página
const chapters = [
  {
    file: 'compressed/2022-03-08 182826.webp',
    date: '8 · marzo · 2022',
    year: 2022,
    theme: 'papel',
    title: 'Donde todo empezó',
    text: 'Una fecha especial guardada para siempre en el alma. Gracias por cada segundo que hemos caminado juntos.',
  },
  {
    file: 'compressed/2023-05-22 135732.webp',
    date: '22 · mayo · 2023',
    year: 2023,
    theme: 'girasol',
    title: 'Tiempos dorados',
    text: 'De los primeros capítulos de nuestra hermosa historia, que siempre recordaré con infinita ternura.',
  },
  {
    file: 'compressed/2023-05-26 175954.webp',
    date: '26 · mayo · 2023',
    year: 2023,
    theme: 'vino',
    title: 'Momentos que atesoro',
    text: 'Cada recuerdo a tu lado es un tesoro que guardo con todo el cariño en mi mente y en mi corazón.',
  },
  {
    file: 'compressed/IMG-20260714-WA0212.webp',
    date: '14 · julio · 2026',
    year: 2026,
    theme: 'cielo',
    title: 'Tu dulzura sin igual',
    text: 'Esa manera tan tuya de iluminar todo a tu alrededor con una sola palabra, una caricia o una sonrisa.',
  },
  {
    file: 'compressed/20260715_214458(1).webp',
    date: '15 · julio · 2026',
    year: 2026,
    theme: 'noche',
    title: 'Bajo las estrellas',
    text: 'Caminando juntos, sintiendo que el tiempo se detiene por completo cuando estamos cerca el uno del otro.',
  },
];

const N = chapters.length;
const at = (i: number) => (i / N).toFixed(3);
const pad = (n: number) => String(n).padStart(2, '0');
// Inclinación de cada foto, alternando lados como si estuvieran sobre una mesa
const tilt = (i: number) => [-2.4, 1.8, -1.2, 2.6, -1.6][i % 5];
---

<section class="scene capitulos" data-scene="capitulos" data-theme="papel" data-year="2022" style={`--len: ${N * 160}`}>
  <div class="stage">
    <div class="prints" aria-hidden="true">
      {
        chapters.map((c, i) => (
          <figure class="layer print" style={`--a: ${i === 0 ? -1 : at(i)}; --b: ${i === N - 1 ? 2 : at(i + 1)}; --r: ${tilt(i)}deg`}>
            <img src={encodeURI(`${baseUrl}/images/${c.file}`)} alt="" loading="lazy" decoding="async" />
          </figure>
        ))
      }
    </div>

    <ol class="captions stack">
      {
        chapters.map((c, i) => (
          <li class="beat" data-beat={i === N - 1 ? at(i) : `${at(i)} ${at(i + 1)}`} data-theme={c.theme} data-year={c.year}>
            <p class="mono meta"><span>{pad(i + 1)} / {pad(N)}</span><span>{c.date}</span></p>
            <h2>{c.title}</h2>
            <p class="text">{c.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--gutter);
    padding-inline: var(--gutter);
  }

  .prints {
    position: relative;
    justify-self: center;
    width: min(100%, 30rem, 58svh);
    aspect-ratio: 4 / 5;
  }

  /* Cada foto entra girada y se endereza mientras dura su capítulo.
     El fundido ocupa un 30 % del capítulo: la que entra sube desde abajo y la que sale se va hacia arriba */
  .print {
    --fade: 0.06;
    --a0: max(var(--a), 0);
    --k: clamp(0, (var(--p, 0) - var(--a0)) / (min(var(--b), 1) - var(--a0)), 1);
    margin: 0;
    padding: clamp(0.5rem, 1.2vw, 0.9rem) clamp(0.5rem, 1.2vw, 0.9rem) clamp(2rem, 4vw, 3.25rem);
    background: #fbf8f2;
    box-shadow: 0 2rem 4rem rgb(0 0 0 / 0.35), 0 0.25rem 0.75rem rgb(0 0 0 / 0.2);
    transform:
      translateY(calc((1 - var(--layer-o)) * 7vh * (1 - 2 * var(--k))))
      scale(calc(1 - (1 - var(--layer-o)) * 0.04))
      rotate(calc(var(--r) + (0.5 - var(--k)) * 2deg));
    overflow: hidden;
  }

  .print img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(calc(1.12 - 0.12 * var(--k)));
  }

  .captions {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 30rem;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.9rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid currentColor;
    color: var(--fg-dim);
  }

  h2 {
    font-size: var(--t-display);
    font-weight: 300;
    line-height: 0.92;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .text {
    margin-top: 1.5rem;
    max-width: 34ch;
    font-size: var(--t-body);
    color: var(--fg-dim);
  }

  /* En móvil: la foto arriba, el texto abajo */
  @media (max-width: 760px) {
    .stage {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto;
      align-content: center;
      gap: 1.75rem;
      padding-block: 4.5rem calc(3.5rem + var(--chrome));
    }

    .prints {
      width: min(78vw, 44svh);
      align-self: end;
    }

    h2 { font-size: clamp(2.4rem, 11vw, 3.5rem); }
    .meta { margin-bottom: 1rem; }
    .text { margin-top: 0.9rem; font-size: 1.05rem; }
  }

  html:not(.js) .prints { display: none; }
</style>
