---
const rawBase = import.meta.env.BASE_URL || '/';
const baseUrl = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
---

<section class="scene cierre" data-scene="cierre" data-theme="girasol" data-year="2026" data-p-range="0 0.6" style="--len: 260">
  <div class="stage">
    <h2 class="thanks">Gracias<br /><em>por existir</em></h2>

    <nav class="end beat" data-beat="0.55" aria-label="Seguir">
      <a href="#album">Ver el álbum <span aria-hidden="true">↓</span></a>
      <a href={`${baseUrl}/recuerdos/`}>Abrir recuerdos <span aria-hidden="true">→</span></a>
      <a href={`${baseUrl}/`}>Volver al sobre <span aria-hidden="true">↺</span></a>
    </nav>
  </div>
</section>

<style>
  .stage {
    display: grid;
    place-items: center;
    padding-inline: var(--gutter);
  }

  /* El texto llega grande y se asienta, luego sube para dejar sitio al final */
  .thanks {
    --in: clamp(0, var(--p, 1) / 0.35, 1);
    --up: clamp(0, (var(--p, 1) - 0.45) / 0.15, 1);
    font-size: var(--t-giant);
    font-weight: 300;
    line-height: 0.84;
    letter-spacing: -0.04em;
    text-align: center;
    opacity: var(--in);
    transform: translateY(calc(var(--up) * -8vh)) scale(calc(1.18 - 0.18 * var(--in)));
  }

  .thanks em { font-style: italic; }

  .end {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: calc(clamp(3rem, 12vh, 7rem) + var(--chrome));
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 2.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .end a {
    color: var(--fg);
    text-decoration: none;
    padding-bottom: 0.3rem;
    border-bottom: 1px solid currentColor;
    transition: opacity 0.2s;
  }

  .end a:hover { opacity: 0.6; }

  html:not(.js) .end {
    position: relative;
    inset: auto;
    margin-top: 10vh;
  }
</style>
