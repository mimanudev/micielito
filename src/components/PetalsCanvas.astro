---
// Canvas flotante de pétalos de flores amarillas y destellos dorados
---

<canvas id="petalsCanvas" class="fixed inset-0 pointer-events-none z-0 opacity-80"></canvas>

<script>
  function initPetals() {
    const canvas = document.getElementById('petalsCanvas') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = (canvas.width = window.innerWidth);
    let height = (canvas.height = window.innerHeight);

    window.addEventListener('resize', () => {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
    });

    interface Particle {
      x: number;
      y: number;
      size: number;
      speedX: number;
      speedY: number;
      rotation: number;
      rotationSpeed: number;
      opacity: number;
      color: string;
      isSparkle: boolean;
      oscillation: number;
      oscillationSpeed: number;
    }

    const yellowColors = [
      '#fef08a', // light yellow
      '#fde047', // vivid yellow
      '#facc15', // warm yellow
      '#eab308', // amber
      '#f59e0b', // golden amber
    ];

    const particles: Particle[] = [];
    const count = window.innerWidth < 768 ? 35 : 65;

    for (let i = 0; i < count; i++) {
      const isSparkle = Math.random() > 0.45;
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        size: isSparkle ? Math.random() * 2.5 + 1 : Math.random() * 9 + 6,
        speedX: Math.random() * 0.8 - 0.4,
        speedY: isSparkle ? Math.random() * 0.4 - 0.6 : Math.random() * 0.8 + 0.6, // sparkles float up, petals fall down
        rotation: Math.random() * Math.PI * 2,
        rotationSpeed: (Math.random() - 0.5) * 0.03,
        opacity: Math.random() * 0.6 + 0.3,
        color: yellowColors[Math.floor(Math.random() * yellowColors.length)],
        isSparkle,
        oscillation: Math.random() * Math.PI * 2,
        oscillationSpeed: Math.random() * 0.02 + 0.01,
      });
    }

    function drawPetal(ctx: CanvasRenderingContext2D, p: Particle) {
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rotation);
      ctx.globalAlpha = p.opacity;

      if (p.isSparkle) {
        // Glowing star sparkle
        ctx.fillStyle = p.color;
        ctx.shadowColor = '#fbbf24';
        ctx.shadowBlur = 8;
        ctx.beginPath();
        ctx.arc(0, 0, p.size, 0, Math.PI * 2);
        ctx.fill();
      } else {
        // Organic flower petal shape
        ctx.fillStyle = p.color;
        ctx.shadowColor = 'rgba(245, 158, 11, 0.4)';
        ctx.shadowBlur = 6;
        ctx.beginPath();
        ctx.moveTo(0, -p.size);
        ctx.quadraticCurveTo(p.size * 0.7, -p.size * 0.3, 0, p.size);
        ctx.quadraticCurveTo(-p.size * 0.7, -p.size * 0.3, 0, -p.size);
        ctx.fill();
      }

      ctx.restore();
    }

    function animate() {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, height);

      particles.forEach((p) => {
        p.oscillation += p.oscillationSpeed;
        p.x += p.speedX + Math.sin(p.oscillation) * 0.5;
        p.y += p.speedY;
        p.rotation += p.rotationSpeed;

        // Wrap around screen
        if (p.y > height + 20) {
          p.y = -20;
          p.x = Math.random() * width;
        } else if (p.y < -20) {
          p.y = height + 20;
          p.x = Math.random() * width;
        }

        if (p.x > width + 20) p.x = -20;
        if (p.x < -20) p.x = width + 20;

        drawPetal(ctx, p);
      });

      requestAnimationFrame(animate);
    }

    animate();
  }

  // Run on mount
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPetals);
  } else {
    initPetals();
  }
</script>
