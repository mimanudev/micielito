---
interface Props {
  className?: string;
  size?: number;
}

const { className = "w-12 h-12", size = 48 } = Astro.props;
---

<div class={`relative inline-flex items-center justify-center ${className}`}>
  <!-- Glow aura -->
  <div class="absolute inset-0 rounded-full bg-amber-400/30 blur-md animate-pulse"></div>
  
  <svg
    viewBox="0 0 100 100"
    class="w-full h-full relative z-10 drop-shadow-[0_0_8px_rgba(251,191,36,0.8)]"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="petalGrad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#fef08a" />
        <stop offset="60%" stop-color="#f59e0b" />
        <stop offset="100%" stop-color="#d97706" />
      </linearGradient>
      <radialGradient id="centerGrad" cx="40%" cy="40%" r="60%">
        <stop offset="0%" stop-color="#542e0e" />
        <stop offset="70%" stop-color="#271202" />
        <stop offset="100%" stop-color="#140700" />
      </radialGradient>
      <filter id="sunGlow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>
    </defs>

    <!-- Outer Golden Petals (16 Petals) -->
    <g class="origin-center transition-transform duration-700 hover:rotate-45">
      {Array.from({ length: 16 }).map((_, i) => {
        const angle = i * (360 / 16);
        return (
          <path
            d="M 50 12 C 45 26, 43 38, 50 48 C 57 38, 55 26, 50 12 Z"
            fill="url(#petalGrad)"
            transform={`rotate(${angle} 50 50)`}
          />
        );
      })}
      <!-- Inner Offset Petals for Richness -->
      {Array.from({ length: 16 }).map((_, i) => {
        const angle = i * (360 / 16) + 11.25;
        return (
          <path
            d="M 50 18 C 46 29, 44 38, 50 48 C 56 38, 54 29, 50 18 Z"
            fill="#fbbf24"
            opacity="0.9"
            transform={`rotate(${angle} 50 50)`}
          />
        );
      })}
    </g>

    <!-- Sunflower Center -->
    <circle cx="50" cy="50" r="18" fill="url(#centerGrad)" stroke="#b45309" stroke-width="1.5" />
    <circle cx="50" cy="50" r="14" fill="#1e0c03" opacity="0.6" stroke="#f59e0b" stroke-dasharray="2,2" stroke-width="1" />
    <circle cx="50" cy="50" r="7" fill="#0f0501" />
  </svg>
</div>
