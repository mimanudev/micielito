---
// Modal dedicado para la playlist de Spotify
---

<div
  id="spotifyModal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-4 bg-black/85 backdrop-blur-md transition-all duration-300 select-none"
  aria-modal="true"
  role="dialog"
>
  <!-- Modal Card -->
  <div
    id="spotifyModalBox"
    class="relative w-full max-w-lg bg-[#120d24] border border-emerald-500/40 rounded-3xl shadow-[0_0_60px_rgba(16,185,129,0.3)] overflow-hidden p-6 text-white"
  >
    <!-- Close Button -->
    <button
      id="spotifyCloseBtn"
      class="absolute top-4 right-4 z-20 w-9 h-9 rounded-full bg-black/60 hover:bg-emerald-500 text-emerald-300 hover:text-black border border-emerald-500/30 flex items-center justify-center transition-all duration-300 hover:scale-110 hover:rotate-90 cursor-pointer shadow-lg"
      aria-label="Cerrar reproductor"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Header -->
    <div class="flex items-center gap-3 mb-4">
      <div class="w-10 h-10 rounded-full bg-[#1db954]/20 border border-[#1db954]/50 flex items-center justify-center text-xl shadow-[0_0_15px_rgba(29,185,84,0.4)]">
        🟢
      </div>
      <div>
        <h3 class="font-serif text-xl md:text-2xl text-amber-100 font-medium leading-tight">
          Nuestra Playlist en Spotify
        </h3>
        <p class="text-xs text-emerald-300/80 mt-0.5">
          Canciones que iluminan el alma y me recuerdan a ti 🌻
        </p>
      </div>
    </div>

    <!-- Spotify Embed Iframe Container -->
    <div class="w-full rounded-2xl overflow-hidden bg-black/50 p-1 border border-emerald-500/20 shadow-inner">
      <iframe
        data-testid="embed-iframe"
        style="border-radius:12px"
        src="https://open.spotify.com/embed/playlist/2fVXw9OzIALQuzhdjN55EQ?utm_source=generator&si=3209349f2fb040f3"
        width="100%"
        height="352"
        frameBorder="0"
        allowfullscreen=""
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        loading="lazy"
      ></iframe>
    </div>

    <!-- Bottom note -->
    <div class="mt-4 pt-3 border-t border-emerald-500/15 flex items-center justify-between text-xs text-amber-100/60">
      <span class="flex items-center gap-1">
        <span>🎧</span> Ponle play y disfruta los recuerdos
      </span>
      <span class="text-[11px] text-emerald-400 font-mono">
        Con amor 💚
      </span>
    </div>
  </div>
</div>
