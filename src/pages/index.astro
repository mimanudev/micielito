---
import '../styles/global.css';
import HeroHome from '../components/HeroHome.astro';

const rawBase = import.meta.env.BASE_URL || '/';
const baseUrl = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" as="image" href={`${baseUrl}/images/compressed/inicio.webp`} />
    <title>Flores Amarillas Para Ti | Mi Cielito</title>
    <meta name="description" content="Una portada para nuestra historia de amor y recuerdos juntos." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Playfair+Display:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#0c0915] text-slate-100 min-h-screen overflow-x-hidden selection:bg-amber-400 selection:text-black">
    <main class="home-main relative z-10 flex min-h-screen items-start justify-center px-4 py-8 sm:items-center sm:py-10">
      <HeroHome />
    </main>
  </body>
</html>
